# Local rule development only. Never expose this mode outside localhost.
AEGIS_DEPLOYED=0
AEGIS_AUTH_ENABLED=0
AEGIS_DB_PATH=
AEGIS_FORCE_RULES=1
AEGIS_SITE_PROFILE=academic
AEGIS_ALLOWED_ORIGINS=http://localhost:8501

# For deployment generate deploy.env using: python scripts/manage.py init
# Guest access uses expiring signed passes issued by the front desk;
# a global shared guest token is intentionally unsupported.
AEGIS_STAFF_TOKEN=
AEGIS_SIGNING_KEY=
AEGIS_STAFF_KEYS_JSON={}

# Optional validated initial PMS JSON / approved policy JSON (read at startup).
AEGIS_PMS_FILE=
AEGIS_KNOWLEDGE_FILE=

# Optional model configuration. The web container never receives these values.
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=
