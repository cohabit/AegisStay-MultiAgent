# Runtime mode
AEGIS_FORCE_RULES=1
AEGIS_DB_PATH=/data/aegisstay.sqlite3

# Enable bearer authentication in a deployed environment.
AEGIS_AUTH_ENABLED=0
AEGIS_GUEST_TOKEN=replace-with-guest-token
AEGIS_STAFF_TOKEN=replace-with-staff-token
AEGIS_ALLOWED_ORIGINS=http://localhost:8501

# Optional OpenAI-compatible model endpoint. Keep keys in a secret manager.
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=
